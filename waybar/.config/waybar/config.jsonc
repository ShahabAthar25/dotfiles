{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 10,
  "height": 30,
  "border-radius": 25,
  "margin-right": 10,
  "margin-left": 10,
  "margin-top": 2,
  "modules-left": [],
  "modules-center": [
    "group/center4",
    "group/center3",
    "hyprland/workspaces",
    "group/center2",
  ],
  "modules-right": [],

  // GROUPS MODULE

  "group/center2": {
    "orientation": "inherit",
    "modules": ["custom/clock", "group/right1", "cpu", "memory"],
  },

  "group/center3": {
    "orientation": "inherit",
    "modules": [
      "custom/notification",
      "custom/idle-indicator",
      "custom/notification-silencing-indicator",
      "custom/screenrecording-indicator",
      "custom/update",
      "custom/separator#dot",
      "custom/media",
    ],
  },

  "group/center4": {
    "orientation": "inherit",
    "modules": [
      "custom/launcher",
      "custom/active_window",
      "custom/separator#dot",
      "tray",
      "network",
      "bluetooth",
      "pulseaudio",
      "backlight",
    ],
  },

  // MODULES

  "custom/active_window": {
    "exec": "~/.config/waybar/window.sh",
    "return-type": "json",
    "markup": true,
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "1": "<span size='13500'>󰲠</span>",
      "2": "<span size='13500'>󰲢</span>",
      "3": "<span size='13500'>󰲤</span>",
      "4": "<span size='13500'>󰲦</span>",
      "5": "<span size='13500'>󰲨</span>",
      "6": "<span size='13500'>󰲪</span>",
      "7": "<span size='13500'>󰲬</span>",
      "8": "<span size='13500'>󰲮</span>",
      "9": "<span size='13500'>󰲰</span>",
      "10": "<span size='13500'>󰿬</span>",
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
    },
  },

  "custom/launcher": {
    // "format": "󰹡",
    "format": "<span size='11500'></span>",
    "on-click": "rofi -show drun",
    "on-click-right": "xdg-terminal-exec",
    "tooltip-format": "Omarchy Menu\n\nSuper + Alt + Space",
  },

  "cpu": {
    "interval": 2,
    "format": "{icon} ",
    "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "on-click": "kitty htop",
  },

  "memory": {
    "interval": 2,
    "format": "{icon} ",
    "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "on-click": "kitty htop",
  },

  "custom/clock": {
    "exec": "~/.config/waybar/clock.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": false,
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "<span size='11500'>󰌘</span>",
    "format-disconnected": "<span size='11500'>󰤮</span>",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "/home/shahab/.config/rofi/scripts/wifi.sh",
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "omarchy-menu power",
    "states": {
      "warning": 20,
      "critical": 10,
    },
  },

  "bluetooth": {
    "format": "<span>󰂯</span>",
    "format-disabled": "<span>󰂲</span>",
    "format-connected": "<span></span>",
    "format-no-controller": "<span>󰂯</span>",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "/home/shahab/.config/waybar/bluetooth.sh",
  },

  "pulseaudio": {
    "format": "<span size='11500'>{icon}</span>",
    "on-click": "omarchy-launch-or-focus-tui wiremix",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": [" ", " ", " "],
    },
    "on-click": "pavucontrol",
  },

  "backlight": {
    "device": "intel_backlight", // Or your display driver (e.g., amdgpu_bl0)
    "format": "<span size='11500'>{icon}</span>",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness: {percent}%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "smooth-scrolling-threshold": 1,
  },

  "custom/screenrecording-indicator": {
    "on-click": "omarchy-cmd-screenrecord",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json",
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },

  "custom/media": {
    "exec": "title=$(playerctl metadata title 2>/dev/null); if [ -n \"$title\" ]; then echo \"<span size='12000'></span> <span size='10000' color='#ffffff'>${title:0:25}</span>\"; else echo \"<span size='12000'></span> <span size='10000' color='#ffffff'>No media</span>\"; fi",
    "interval": 2,
    "on-click": "playerctl play-pause",
  },

  "custom/separator#blank": {
    "format": " ",
    "interval": "once",
    "tooltip": false,
  },

  "custom/separator#dot": {
    "format": " ",
    "interval": "once",
    "tooltip": false,
  },

  "custom/update": {
    "format": "",
    "exec": "echo 'Not Implemented'",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "tooltip-format": "Omarchy update available",
    "signal": 7,
    "interval": 21600,
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup><sup>●</sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup><sup>●</sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup><sup>●</sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup><sup>●</sup></sup></span>",
      "dnd-inhibited-none": "",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },

  // "custom/idle-indicator": {
  //   "on-click": "omarchy-toggle-idle",
  //   "exec": "echo 'Not Implemented'",
  //   "signal": 9,
  //   "return-type": "json",
  // },

  // "custom/notification-silencing-indicator": {
  //   "on-click": "omarchy-toggle-notification-silencing",
  //   "exec": "echo Not",
  //   "signal": 10,
  //   "return-type": "json",
  // },
}
